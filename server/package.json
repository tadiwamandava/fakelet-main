    "@inertiajs/react": "^3.6.1",
    "@japa/api-client": "^3.2.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@tuyau/core": "^1.2.2",
    "@types/nodemailer": "^8.0.1",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^12.10.0",
    "crossws": "^0.4.12",
    "edge.js": "^6.5.1",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.1",
