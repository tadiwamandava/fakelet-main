# Copy to .env and fill in. Never commit the real .env.

# Node
TZ=UTC
HOST=0.0.0.0
PORT=3333
NODE_ENV=production
LOG_LEVEL=info

# App
# Generate with: node ace generate:key
APP_KEY=
# Public URL of the deployment, e.g. https://hive.example.edu
APP_URL=https://hive.example.edu

# Session
SESSION_DRIVER=cookie

# Only needed when the frontend is served from a DIFFERENT origin than the API.
# Leave unset when both are on the same domain. Comma-separated for multiple.
# CORS_ORIGIN=https://hive.example.edu

# Base URL for signup links in invitation emails. Defaults to APP_URL, so this
# is only needed if the frontend lives on another domain.
# FRONTEND_URL=https://hive.example.edu

# Where uploaded images are stored. Must be an absolute path OUTSIDE the build
# directory, otherwise uploads are wiped on every deploy.
# UPLOADS_DIR=/var/lib/hive/uploads

# Database (PostgreSQL)
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=hive
DB_PASSWORD=
DB_DATABASE=hive

# SMTP. Omit SMTP_HOST entirely in development to print invitation links and
# password reset codes to the console instead of sending real mail.
# SMTP_USERNAME/SMTP_PASSWORD are optional: leave them unset for an internal
# relay that accepts unauthenticated mail.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Defaults to no-reply@<APP_URL host> when unset.
# SMTP_FROM=no-reply@example.edu

# Seeded first admin (used by: node ace db:seed --files admin_user_seeder)
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=
