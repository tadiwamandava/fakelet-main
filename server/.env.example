# Template. Copy to .env and fill in. Never commit the real .env.


# ── Node ─────────────────────────────────────────────────────────────────────
TZ=UTC
HOST=0.0.0.0
PORT=3333
NODE_ENV=production
LOG_LEVEL=info

# ── App ──────────────────────────────────────────────────────────────────────
# SERVER: generate a fresh one there with: node ace generate:key
# (Changing this invalidates all sessions and API tokens.)
APP_KEY=
# SERVER: set to your public URL, e.g. https://hive.example.edu
APP_URL=https://hive.example.edu

SESSION_DRIVER=cookie

# ── Database ─────────────────────────────────────────────────────────────────
# SERVER: point at your Postgres instance
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=hive
DB_PASSWORD=
DB_DATABASE=hive

# ── Uploads ──────────────────────────────────────────────────────────────────
# Must live OUTSIDE the build directory: 'node ace build' recreates that folder,
# which would delete every uploaded image on deploy.
# SERVER: e.g. /var/lib/hive/uploads (must be writable by the app user)
UPLOADS_DIR=/var/lib/hive/uploads

# ── Email ────────────────────────────────────────────────────────────────────
# With SMTP_HOST unset, invitation links and password-reset codes print to the
# server console instead of being emailed - which is what you want locally.
# SERVER: uncomment and point at your mail relay.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.edu

# ── First admin (used by: node ace db:seed --files database/seeders/admin_user_seeder.ts)
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=

# ── Cross-origin ─────────────────────────────────────────────────────────────
# Not needed: the app and API are served from one origin. Only set CORS_ORIGIN
# and FRONTEND_URL if you ever split the frontend onto a different domain.
